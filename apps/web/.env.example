# Base de données. Sans DATABASE_URL, une base PostgreSQL locale (PGlite) est créée dans .data/
# DATABASE_URL=postgresql://postgres:motdepasse@db.<projet>.supabase.co:5432/postgres
# PGLITE_DATA_DIR=.data/pglite

# Jeu de paramètres réglementaires des audits réels (toujours « officiel » en production).
PARAMETER_DATASET=officiel

# API publique Recherche d'entreprises (sans clé).
COMPANY_SEARCH_BASE_URL=https://recherche-entreprises.api.gouv.fr

# Lien magique (phase 4) : désactivé tant qu'aucun fournisseur n'est configuré.
# MAGIC_LINK_ENABLED=false

# Mode démonstration (Boulangerie Démo, paramètres fictifs) : activé par défaut hors production.
# DEMO_ENABLED=true

# --- Authentification (phase 4) ---
# « supabase » en production (défaut), « local » en développement (défaut hors production, refusé en production).
# AUTH_PROVIDER=supabase
# NEXT_PUBLIC_SUPABASE_URL=https://<projet>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=...
# Modèle d'e-mail « Magic Link » de Supabase : lien vers
#   {{ .SiteURL }}/auth/confirmer?token_hash={{ .TokenHash }}&type=email&suivant=/espace
# Origine des liens envoyés par e-mail (obligatoire en production).
# APP_URL=https://www.exemple.fr

# --- E-mails ---
# « brevo » en production (défaut), « outbox » en développement (e-mails visibles sur /dev/emails).
# MAIL_PROVIDER=brevo
# BREVO_API_KEY=...
# MAIL_FROM_EMAIL=contact@exemple.fr
# MAIL_FROM_NAME=Récupération PME
